{
  "manifest_version": 3,
  "name": "Bingo DeepSeek Build",
  "version": "2.1.0",
  "description": "Agente de desenvolvimento para DeepSeek com ferramentas de projeto e bridge local.",
  "permissions": ["storage", "downloads"],
  "host_permissions": ["https://chat.deepseek.com/*", "https://www.deepseek.com/*"],
  "action": {
    "default_title": "Bingo DeepSeek Build",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*", "https://www.deepseek.com/*"],
      "js": ["agent/tool-engine.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
