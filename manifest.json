{
  "manifest_version": 3,
  "name": "Bingo DeepSeek Build",
  "version": "2.19.0",
  "description": "BINGO Extension Stage 15 — gerenciador universal de pacotes e dependências.",
  "permissions": ["storage", "downloads"],
  "host_permissions": ["https://chat.deepseek.com/*", "https://www.deepseek.com/*", "http://127.0.0.1:8765/*", "http://127.0.0.1:8766/*", "ws://127.0.0.1:8766/*"],
  "action": {"default_title": "Bingo DeepSeek Build", "default_popup": "popup.html"},
  "content_scripts": [{
    "matches": ["https://chat.deepseek.com/*", "https://www.deepseek.com/*"],
    "js": ["agent/extension-core.js", "agent/extension-foundation.js", "agent/security-engine-v13.js", "agent/production-engine-v15.js", "agent/protocol-v2.js", "agent/deepseek-adapter-v11.js", "agent/deepseek-bridge-v2.js", "agent/invisible-transport-v3.js", "agent/tool-registry-v11.js", "agent/tool-engine-v5.js", "agent/terminal-tools-v13.js", "agent/diagnostics-engine-v14.js", "agent/diagnostics-tools-v14.js", "agent/package-tools-v15.js", "agent/context-engine-v6.js", "agent/continuity-v7.js", "agent/autonomy-controller-v8.js", "agent/permission-handshake-v9.js", "agent/multi-transport-v10.js", "agent/performance-engine-v12.js", "agent/diagnostics-bridge-v14.js", "agent/tool-engine.js", "agent/python-bridge-client.js", "content.js", "agent/v7-injector.js", "agent/v10-injector.js", "agent/v11-injector.js", "agent/v11-runtime-guard.js", "agent/desktop-bridge-v5.js"],
    "run_at": "document_idle"
  }],
  "background": {"service_worker": "agent/background-v5.js"}
}
